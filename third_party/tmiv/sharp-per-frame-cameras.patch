     m_aggregatedEntityMask.clear();
diff --git a/source/ViewOptimizer/src/ViewOptimizerStage.cpp b/source/ViewOptimizer/src/ViewOptimizerStage.cpp
index a4f6825..61a299b 100644
--- a/source/ViewOptimizer/src/ViewOptimizerStage.cpp
+++ b/source/ViewOptimizer/src/ViewOptimizerStage.cpp
@@ -47,7 +47,17 @@ void ViewOptimizerStage::encode(SourceUnit unit) {
   if (!m_params) {
     m_params = m_optimizer->optimizeParams({unit.viewParamsList, unit.depthLowQualityFlag});
   }
-  unit.viewParamsList = m_params->viewParamsList;
+  // Per-frame camera poses (SHARP Stage 2): the view selection is made once per sequence, but
+  // each frame's source poses are carried through so that pose changes reach the encoder.
+  auto viewParamsList = m_params->viewParamsList;
+  for (auto &viewParams : viewParamsList) {
+    for (const auto &sourceViewParams : unit.viewParamsList) {
+      if (sourceViewParams.name == viewParams.name) {
+        viewParams.pose = sourceViewParams.pose;
+      }
+    }
+  }
+  unit.viewParamsList = std::move(viewParamsList);
   unit.deepFrameList = m_optimizer->optimizeFrame(std::move(unit.deepFrameList));
   unit.semiBasicViewCount = m_params->semiBasicCount;
   source.encode(unit);
