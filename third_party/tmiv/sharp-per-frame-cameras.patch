   void process(std::vector<SourceUnit> buffer, const Common::StageSource<CodableUnit> &source_) {
     if (m_firstIdx == 0) {
       prepareSequence(buffer.front());
+    } else {
+      updateViewPoses(buffer.front());
     }
 
     m_params.foc = m_firstIdx % m_config.intraPeriod;
@@ -569,6 +571,25 @@ private:
     }
   }
 
+  // Per-frame camera poses (SHARP Stage 2): update the transported view poses for this access
+  // unit. Only the extrinsics may change; EncodeMiv then codes them as view parameter updates.
+  void updateViewPoses(const SourceUnit &unit) {
+    const auto &viewParamsList = unit.viewParamsList;
+    if (viewParamsList.size() != m_transportViewParams.size() ||
+        viewParamsList.size() != m_params.viewParamsList.size()) {
+      throw std::runtime_error("The number of views may not change within a sequence");
+    }
+    for (size_t i = 0; i < viewParamsList.size(); ++i) {
+      if (viewParamsList[i].ci != m_transportViewParams[i].ci ||
+          viewParamsList[i].dq != m_transportViewParams[i].dq) {
+        throw std::runtime_error("View " + viewParamsList[i].name +
+                                 ": only the pose may change between frames");
+      }
+      m_transportViewParams[i].pose = viewParamsList[i].pose;
+      m_params.viewParamsList[i].pose = viewParamsList[i].pose;
+    }
+  }
+
   void prepareAccessUnit() {
